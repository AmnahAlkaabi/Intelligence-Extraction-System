# Copy this file to `.env` (backend/.env) and adjust for your on-prem deployment.
# Nothing in this app calls out to the public internet at runtime — every
# endpoint below should point at hosts reachable inside your air-gapped network.

# --- Qwen: translation preprocessing model ---
QWEN_BASE_URL=http://10.100.100.105:8021/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=unsloth/Qwen3.8-27B-GGUF-1

# --- Kimi2: extraction, synthesis, and chat model ---
KIMI_BASE_URL=http://10.144.2.32:8001/v1
KIMI_API_KEY=EMPTY
KIMI_MODEL_NAME=unsloth/Kimi-K2.6-GGUF

# Logical role -> backend mapping. Values: "qwen" | "kimi"
ROLE_EXTRACTION=kimi
ROLE_SYNTHESIS=kimi
ROLE_CHAT=kimi
# Translation deliberately stays on Qwen rather than following the rest of
# extraction onto Kimi -- listed explicitly here so that's an intentional
# choice, not a silent default someone has to go find in config.py.
ROLE_TRANSLATION=qwen

LLM_REQUEST_TIMEOUT_S=180
LLM_MAX_RETRIES=3

# --- BGE embeddings (downloaded once, cached locally, no network at runtime) ---
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# --- Docling / OCR ---
OCR_LANG=eng
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
RAPIDOCR_TEXT_SCORE=0.5

# --- Neo4j (graph store + vector index = GraphRAG backend) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
VECTOR_INDEX_NAME=chunk_embeddings

# --- Storage ---
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_MB=500
# Persistent, cross-job library every extracted structured table (CSV/
# Excel/Database) is saved into -- kept outside OUTPUT_DIR on purpose,
# since it survives job deletion (see storage/dataset_library.py).
DATASET_LIBRARY_DB_PATH=./data/dataset_library.db

# --- Object storage (OBS) uploads -- OPTIONAL, opt-in per deployment via
# Settings > Storage in the frontend. This deployment runs fully
# air-gapped without ever touching these; leave them unset unless you're
# intentionally connecting to a reachable S3-compatible bucket
# (storage/obs_settings.py / storage/obs_client.py).
OBS_SETTINGS_DB_PATH=./data/obs_settings.db
# Leave unset to auto-generate + persist an encryption key at
# OBS_SECRET_KEY_PATH on first use; set this instead if your deployment
# manages secrets externally (e.g. injected from a secrets manager).
# OBS_ENCRYPTION_KEY=
OBS_SECRET_KEY_PATH=./data/.obs_secret.key
OBS_CONNECT_TIMEOUT_S=5.0
OBS_READ_TIMEOUT_S=15.0

# --- Pipeline ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MAX_PARALLEL_FILES=4
MAX_PARALLEL_FILES_GLOBAL=8
JOB_RETRY_LIMIT=2

# --- Importance-ranked batching -- jobs above this file count process in
# ranked batches and pause for user confirmation between them ---
BATCH_THRESHOLD_FILES=30
BATCH_SIZE_FILES=15

# --- API ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_PREFIX=/api
