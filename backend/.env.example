# Copy this file to `.env` (backend/.env) and adjust for your on-prem deployment.
# Nothing in this app calls out to the public internet at runtime — every
# endpoint below should point at hosts reachable inside your air-gapped network.

# --- Qwen: primary extraction / per-domain reasoning model ---
QWEN_BASE_URL=http://10.100.100.105:8025/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=Qwen3.6-35B-A3B-AWQ

# --- Kimi2: long-context synthesis / chat model ---
KIMI_BASE_URL=http://10.144.2.32:8001/v1
KIMI_API_KEY=EMPTY
KIMI_MODEL_NAME=unsloth/Kimi-K2.6-GGUF

# Logical role -> backend mapping. Values: "qwen" | "kimi"
ROLE_EXTRACTION=qwen
ROLE_SYNTHESIS=kimi
ROLE_CHAT=kimi

LLM_REQUEST_TIMEOUT_S=180
LLM_MAX_RETRIES=3

# --- BGE embeddings (downloaded once, cached locally, no network at runtime) ---
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# --- Docling / OCR ---
OCR_LANG=eng
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
RAPIDOCR_TEXT_SCORE=0.5

# --- Neo4j (graph store + vector index = GraphRAG backend) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
VECTOR_INDEX_NAME=chunk_embeddings

# --- Storage ---
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_MB=500

# --- Pipeline ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MAX_PARALLEL_FILES=4
MAX_PARALLEL_FILES_GLOBAL=8
JOB_RETRY_LIMIT=2

# --- API ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_PREFIX=/api
